{
  "uid": "mcp-node-infra",
  "title": "Node & Infrastructure",
  "description": "Node CPU, memory, disk, network — maps to MCP get_node_status. Shows the box the cluster runs on.",
  "tags": ["mcp-demo", "node", "infrastructure"],
  "style": "dark",
  "schemaVersion": 37,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "timezone": "browser",
  "graphTooltip": 1,
  "editable": true,
  "annotations": {"list": []},
  "templating": {"list": []},
  "links": [],
  "panels": [
    {
      "id": 100, "type": "row", "title": "CPU", "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}
    },
    {
      "id": 1, "type": "timeseries", "title": "Node CPU Utilisation %",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {"lineWidth": 2, "fillOpacity": 12, "spanNulls": false},
          "min": 0, "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.7},
              {"color": "red", "value": 0.9}
            ]
          }
        }
      },
      "options": {"tooltip": {"mode": "multi"}},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[2m]))",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 2, "type": "timeseries", "title": "CPU by Mode (system / user / iowait)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 1},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {"lineWidth": 2, "fillOpacity": 8},
          "min": 0
        }
      },
      "options": {"tooltip": {"mode": "multi"}},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "avg by (mode) (rate(node_cpu_seconds_total{mode!=\"idle\", mode!=\"steal\"}[2m]))",
          "legendFormat": "{{mode}}"
        }
      ]
    },
    {
      "id": 200, "type": "row", "title": "Memory", "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 9}
    },
    {
      "id": 3, "type": "timeseries", "title": "Memory Available",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 10},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {"lineWidth": 2, "fillOpacity": 10},
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 536870912},
              {"color": "green", "value": 1073741824}
            ]
          }
        }
      },
      "options": {"tooltip": {"mode": "multi"}},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "node_memory_MemAvailable_bytes",
          "legendFormat": "Available"
        },
        {
          "refId": "B",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "node_memory_MemTotal_bytes",
          "legendFormat": "Total"
        }
      ]
    },
    {
      "id": 4, "type": "timeseries", "title": "Memory Pressure — Buffers / Cached / Used",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 10},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {"lineWidth": 2, "fillOpacity": 8},
          "min": 0
        }
      },
      "options": {"tooltip": {"mode": "multi"}},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
          "legendFormat": "Used"
        },
        {
          "refId": "B",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "node_memory_Buffers_bytes",
          "legendFormat": "Buffers"
        },
        {
          "refId": "C",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "node_memory_Cached_bytes",
          "legendFormat": "Cached"
        }
      ]
    },
    {
      "id": 300, "type": "row", "title": "Disk & Network", "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 18}
    },
    {
      "id": 5, "type": "timeseries", "title": "Disk I/O",
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 19},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {"lineWidth": 2, "fillOpacity": 8},
          "min": 0
        }
      },
      "options": {"tooltip": {"mode": "multi"}},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "rate(node_disk_read_bytes_total[2m])",
          "legendFormat": "read {{device}}"
        },
        {
          "refId": "B",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "rate(node_disk_written_bytes_total[2m])",
          "legendFormat": "write {{device}}"
        }
      ]
    },
    {
      "id": 6, "type": "timeseries", "title": "Network I/O",
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 19},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {"lineWidth": 2, "fillOpacity": 8}
        }
      },
      "options": {"tooltip": {"mode": "multi"}},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "rate(node_network_receive_bytes_total{device!~\"lo|veth.*\"}[2m])",
          "legendFormat": "rx {{device}}"
        },
        {
          "refId": "B",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "rate(node_network_transmit_bytes_total{device!~\"lo|veth.*\"}[2m])",
          "legendFormat": "tx {{device}}"
        }
      ]
    },
    {
      "id": 400, "type": "row", "title": "Kubernetes Summary", "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 26}
    },
    {
      "id": 7, "type": "stat", "title": "Running Pods (production)",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 27},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 3}, {"color": "green", "value": 5}]
          },
          "color": {"mode": "thresholds"}
        }
      },
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}, "textMode": "auto"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "count(kube_pod_status_phase{namespace=\"production\", phase=\"Running\"})",
          "legendFormat": "Running Pods"
        }
      ]
    },
    {
      "id": 8, "type": "stat", "title": "Pending Pods (production)",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 27},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 2}]
          },
          "color": {"mode": "thresholds"},
          "mappings": [{"type": "value", "options": {"0": {"color": "green", "text": "0"}}}]
        }
      },
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}, "textMode": "auto"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "count(kube_pod_status_phase{namespace=\"production\", phase=\"Pending\"} == 1) OR vector(0)",
          "legendFormat": "Pending Pods"
        }
      ]
    },
    {
      "id": 9, "type": "stat", "title": "Node Allocatable CPU (cores)",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 27},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "green", "value": null}]
          },
          "color": {"mode": "thresholds"}
        }
      },
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}, "textMode": "auto"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "kube_node_status_allocatable{resource=\"cpu\"}",
          "legendFormat": "CPU cores"
        }
      ]
    },
    {
      "id": 10, "type": "stat", "title": "Node Allocatable Memory",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 27},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [{"color": "green", "value": null}]
          },
          "color": {"mode": "thresholds"}
        }
      },
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}, "textMode": "auto"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "kube_node_status_allocatable{resource=\"memory\"}",
          "legendFormat": "Memory"
        }
      ]
    }
  ]
}
