{
  "__inputs": [],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"},
    {"type": "panel", "id": "timeseries", "name": "Time series", "version": ""},
    {"type": "panel", "id": "stat", "name": "Stat", "version": ""}
  ],
  "annotations": {"list": []},
  "description": "MCP Demo — Production Incident Overview",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 100,
      "title": "Service Health",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.01},
              {"color": "red", "value": 0.05}
            ]
          },
          "unit": "percentunit",
          "min": 0
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 1},
      "id": 1,
      "options": {"tooltip": {"mode": "multi"}},
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "rate(payment_requests_total{status=\"500\"}[1m]) / rate(payment_requests_total[1m])",
          "legendFormat": "payment-service",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus"},
          "expr": "rate(orders_total{status=~\"payment_failed|payment_timeout\"}[1m]) / rate(orders_total[1m])",
          "legendFormat": "order-service",
          "refId": "B"
        },
        {
          "datasource": {"type": "prometheus"},
          "expr": "rate(auth_requests_total{status=\"503\"}[1m]) / rate(auth_requests_total[1m])",
          "legendFormat": "auth-service",
          "refId": "C"
        }
      ],
      "title": "Service Error Rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 2, "fillOpacity": 10},
          "unit": "short",
          "min": 0
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 1},
      "id": 2,
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "increase(kube_pod_container_status_restarts_total{namespace=\"production\"}[5m])",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "title": "Pod Restart Rate (production, 5m window)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 2, "fillOpacity": 5},
          "unit": "s",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1.0},
              {"color": "red", "value": 2.0}
            ]
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "SLO (2s)"},
            "properties": [
              {"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}},
              {"id": "custom.lineStyle", "value": {"dash": [10, 10], "fill": "dash"}}
            ]
          }
        ]
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 9},
      "id": 3,
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "histogram_quantile(0.99, rate(order_request_duration_seconds_bucket[2m]))",
          "legendFormat": "order-service p99",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus"},
          "expr": "2.0",
          "legendFormat": "SLO (2s)",
          "refId": "B"
        }
      ],
      "title": "Order Service p99 Latency vs SLO",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          },
          "mappings": [
            {"type": "value", "options": {"0": {"text": "ALL CLEAR", "color": "green"}}},
            {"type": "special", "options": {"match": "null", "result": {"text": "0", "color": "green"}}}
          ]
        }
      },
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 9},
      "id": 4,
      "options": {"colorMode": "background", "graphMode": "none", "textMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "count(ALERTS{alertstate=\"firing\", namespace=\"production\"}) OR vector(0)",
          "legendFormat": "Firing Alerts",
          "refId": "A"
        }
      ],
      "title": "Active Production Alerts",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          }
        }
      },
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 9},
      "id": 5,
      "options": {"colorMode": "background", "graphMode": "none", "textMode": "auto", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "notification_retry_storm_active OR vector(0)",
          "legendFormat": "Retry Storm",
          "refId": "A"
        }
      ],
      "title": "Retry Storm Active",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 2, "fillOpacity": 10},
          "unit": "bytes",
          "min": 0
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 17},
      "id": 6,
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "payment_memory_simulated_bytes",
          "legendFormat": "payment-service simulated heap",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus"},
          "expr": "container_memory_working_set_bytes{namespace=\"production\", container=\"payment\"}",
          "legendFormat": "actual RSS",
          "refId": "B"
        }
      ],
      "title": "Payment Service Memory",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 2, "fillOpacity": 10},
          "unit": "reqps",
          "min": 0
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 17},
      "id": 7,
      "targets": [
        {
          "datasource": {"type": "prometheus"},
          "expr": "rate(email_gateway_requests_total{status=\"429\"}[1m])",
          "legendFormat": "email-gateway 429 rate",
          "refId": "A"
        },
        {
          "datasource": {"type": "prometheus"},
          "expr": "rate(email_gateway_requests_total{status=\"200\"}[1m])",
          "legendFormat": "email-gateway 200 rate",
          "refId": "B"
        }
      ],
      "title": "Email Gateway — Rate Limit Activity",
      "type": "timeseries"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 37,
  "style": "dark",
  "tags": ["mcp-demo", "production", "incident"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      }
    ]
  },
  "time": {"from": "now-15m", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "MCP Demo — Production Incident Overview",
  "uid": "mcp-demo-incidents",
  "version": 1
}
